# ─── Database ─────────────────────────────────────────────────────────────────
# Get from: https://neon.tech or your PostgreSQL provider
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate a strong 64+ character random secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace_with_64_char_random_secret"
JWT_EXPIRES_IN="7d"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Your deployed frontend URL (for CORS and payment redirects)
CLIENT_URL="http://localhost:5173"

# ─── Cloudinary (image uploads) ───────────────────────────────────────────────
# Get from: https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ─── EasyPaisa / EasyPay Hosted Checkout ─────────────────────────────────────
# Apply at: https://easypay.easypaisa.com.pk
# Sandbox portal: https://easypaystg.easypaisa.com.pk
EASYPAISA_STORE_ID="your_store_id_here"
EASYPAISA_HASH_KEY="your_hash_key_here"
# Set to "sandbox" for testing, "production" for live
EASYPAISA_ENV="sandbox"
# Your backend public URL where EasyPaisa will POST the payment callback
EASYPAISA_CALLBACK_URL="https://yourdomain.com/api/payments/easypaisa/callback"
