generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  APPROVED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  REJECTED
}

enum PaymentType {
  COD
  ONLINE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id             Int                  @id @default(autoincrement())
  name           String
  phone          String?              @unique
  email          String?              @unique
  passwordHash   String               @map("password_hash")
  address        String?
  role           Role                 @default(CUSTOMER)
  pointsBalance  Int                  @default(0) @map("points_balance")
  createdAt      DateTime             @default(now()) @map("created_at")
  orders         Order[]
  spinHistory    SpinHistory[]
  promoUsages    PromoUsage[]
  pointsHistory  PointsTransaction[]
  pushSubs       PushSubscription[]
  resetTokens    PasswordResetToken[]
  drawEntries    LuckyDrawEntry[]
  drawWins       LuckyDrawWinner[]
  missionProgress UserMissionProgress[]
  missionVouchers MissionVoucher[]

  @@map("users")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  imageUrl  String?   @map("image_url")
  sortOrder Int       @default(0) @map("sort_order")
  products  Product[]

  @@map("categories")
}

model Product {
  id          Int               @id @default(autoincrement())
  categoryId  Int               @map("category_id")
  name        String
  description String?
  price       Decimal           @db.Decimal(10, 2)
  imageUrl    String?           @map("image_url")
  isAvailable Boolean           @default(true) @map("is_available")
  isFeatured  Boolean           @default(false) @map("is_featured")
  createdAt   DateTime          @default(now()) @map("created_at")
  category    Category          @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  dealItems   DealItem[]
  variants    ProductVariant[]

  @@index([categoryId])
  @@index([isAvailable])
  @@index([isFeatured])
  @@map("products")
}

model ProductVariant {
  id          Int       @id @default(autoincrement())
  productId   Int       @map("product_id")
  name        String                          // "Small" | "Medium" | "Large"
  price       Decimal   @db.Decimal(10, 2)
  isAvailable Boolean   @default(true) @map("is_available")
  sortOrder   Int       @default(0) @map("sort_order")
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  dealItems   DealItem[]

  @@index([productId])
  @@map("product_variants")
}

model Order {
  id             Int         @id @default(autoincrement())
  userId         Int         @map("user_id")
  totalAmount    Decimal     @db.Decimal(10, 2) @map("total_amount")
  discountAmount Decimal     @default(0) @db.Decimal(10, 2) @map("discount_amount")
  promoCode      String?     @map("promo_code")
  paymentType    PaymentType @map("payment_type")
  status         OrderStatus @default(PENDING)
  address        String
  notes          String?
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  user           User        @relation(fields: [userId], references: [id])
  items          OrderItem[]
  payment        Payment?
  promoUsage     PromoUsage?
  pointsTx       PointsTransaction[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id           Int     @id @default(autoincrement())
  orderId      Int     @map("order_id")
  productId    Int?    @map("product_id")
  quantity     Int
  priceAtOrder Decimal @db.Decimal(10, 2) @map("price_at_order")
  // Deal grouping — null for regular items
  dealId       Int?    @map("deal_id")
  dealTitle    String? @map("deal_title")
  dealCartKey  String? @map("deal_cart_key")   // groups items of same deal instance
  customName   String? @map("custom_name")      // for custom (non-menu) deal items
  order        Order   @relation(fields: [orderId], references: [id])
  product      Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([dealId])
  @@map("order_items")
}

model Payment {
  id            Int           @id @default(autoincrement())
  orderId       Int           @unique @map("order_id")
  method        PaymentType
  transactionId String?       @map("transaction_id")
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now()) @map("created_at")
  order         Order         @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model SpinPrize {
  id             Int           @id @default(autoincrement())
  name           String
  description    String?
  imageUrl       String?       @map("image_url")
  weight         Int
  stockRemaining Int?          @map("stock_remaining")
  isActive       Boolean       @default(true) @map("is_active")
  color          String        @default("#FF6B6B")
  createdAt      DateTime      @default(now()) @map("created_at")
  spinHistory    SpinHistory[]

  @@map("spin_prizes")
}

model SpinHistory {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  prizeId    Int       @map("prize_id")
  spunAt     DateTime  @default(now()) @map("spun_at")
  redeemed   Boolean   @default(false)
  redeemedAt DateTime? @map("redeemed_at")
  user       User      @relation(fields: [userId], references: [id])
  prize      SpinPrize @relation(fields: [prizeId], references: [id])

  @@index([userId, spunAt])
  @@index([redeemed])
  @@map("spin_history")
}

model Deal {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  imageUrl    String?    @map("image_url")
  dealPrice   Decimal    @db.Decimal(10, 2) @map("deal_price")
  isActive    Boolean    @default(true) @map("is_active")
  isFeatured  Boolean    @default(false) @map("is_featured")
  createdAt   DateTime   @default(now()) @map("created_at")
  items       DealItem[]

  @@index([isActive])
  @@index([isFeatured])
  @@map("deals")
}

model DealItem {
  id          Int             @id @default(autoincrement())
  dealId      Int             @map("deal_id")
  productId   Int?            @map("product_id")
  variantId   Int?            @map("variant_id")
  quantity    Int             @default(1)
  customName  String?         @map("custom_name")
  customPrice Decimal?        @db.Decimal(10, 2) @map("custom_price")
  deal        Deal            @relation(fields: [dealId], references: [id], onDelete: Cascade)
  product     Product?        @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("deal_items")
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model AppConfig {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_config")
}

model PromoCode {
  id             Int          @id @default(autoincrement())
  code           String       @unique
  description    String?
  discountType   DiscountType @map("discount_type")
  discountValue  Decimal      @db.Decimal(10, 2) @map("discount_value")
  minOrderAmount Decimal?     @db.Decimal(10, 2) @map("min_order_amount")
  maxDiscount    Decimal?     @db.Decimal(10, 2) @map("max_discount")    // cap for PERCENTAGE
  usageLimit     Int?         @map("usage_limit")                         // null = unlimited
  usageCount     Int          @default(0) @map("usage_count")
  perUserLimit   Int          @default(1) @map("per_user_limit")
  isActive       Boolean      @default(true) @map("is_active")
  expiresAt      DateTime?    @map("expires_at")
  // Item restrictions — empty arrays = applies to entire order
  applicableProductIds Int[]  @default([]) @map("applicable_product_ids")
  applicableCategoryIds Int[] @default([]) @map("applicable_category_ids")
  createdAt      DateTime     @default(now()) @map("created_at")
  usages         PromoUsage[]

  @@index([code])
  @@index([isActive])
  @@map("promo_codes")
}

model PromoUsage {
  id        Int       @id @default(autoincrement())
  promoId   Int       @map("promo_id")
  userId    Int       @map("user_id")
  orderId   Int       @unique @map("order_id")
  discount  Decimal   @db.Decimal(10, 2)
  usedAt    DateTime  @default(now()) @map("used_at")
  promo     PromoCode @relation(fields: [promoId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  order     Order     @relation(fields: [orderId], references: [id])

  @@index([promoId])
  @@index([userId])
  @@map("promo_usages")
}

// ─── Lucky Draw (Qurандazi) ───────────────────────────────────────────────────

model LuckyDraw {
  id              Int               @id @default(autoincrement())
  title           String            @default("Lucky Draw")
  description     String?
  bannerUrl       String?           @map("banner_url")
  minSpendAmount  Decimal           @db.Decimal(10, 2) @map("min_spend_amount")
  maxEntries      Int               @default(100) @map("max_entries")  // draw triggers at this many unique users
  isActive        Boolean           @default(true) @map("is_active")
  drawnAt         DateTime?         @map("drawn_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  entries         LuckyDrawEntry[]
  winners         LuckyDrawWinner[]

  @@map("lucky_draws")
}

model LuckyDrawEntry {
  id          Int       @id @default(autoincrement())
  drawId      Int       @map("draw_id")
  userId      Int       @map("user_id")
  totalSpent  Decimal   @db.Decimal(10, 2) @map("total_spent")  // cumulative spend in draw period
  qualifiedAt DateTime  @default(now()) @map("qualified_at")
  draw        LuckyDraw @relation(fields: [drawId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])

  @@unique([drawId, userId])
  @@index([drawId])
  @@index([userId])
  @@map("lucky_draw_entries")
}

model LuckyDrawWinner {
  id        Int       @id @default(autoincrement())
  drawId    Int       @map("draw_id")
  userId    Int       @map("user_id")
  prize     String
  wonAt     DateTime  @default(now()) @map("won_at")
  draw      LuckyDraw @relation(fields: [drawId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([drawId])
  @@map("lucky_draw_winners")
}

// ─── Password Reset ───────────────────────────────────────────────────────────

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

// ─── Loyalty Points ───────────────────────────────────────────────────────────

enum PointsTxType {
  EARN
  REDEEM
  REVOKE
  MANUAL
}

model PointsTransaction {
  id        Int          @id @default(autoincrement())
  userId    Int          @map("user_id")
  orderId   Int?         @map("order_id")
  type      PointsTxType
  points    Int          // positive = earned/added, negative = redeemed/deducted
  note      String?
  createdAt DateTime     @default(now()) @map("created_at")
  user      User         @relation(fields: [userId], references: [id])
  order     Order?       @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@index([orderId])
  @@map("points_transactions")
}

// ─── Weekly Missions ──────────────────────────────────────────────────────────

// Mission type: how progress is measured
enum MissionType {
  ITEMS_BOUGHT   // count total individual items (qty sum) in delivered orders
  DEALS_BOUGHT   // count distinct deal instances bought
}

// A mission definition (admin-managed, seeded by default)
model WeeklyMission {
  id               Int           @id @default(autoincrement())
  title            String
  description      String?
  type             MissionType
  targetCount      Int           @map("target_count")        // e.g. 3, 5, 100, 3
  voucherAmount    Int           @map("voucher_amount")       // Rs 50, 80, 120, 200
  minOrderForVoucher Int         @map("min_order_for_voucher") // Rs 1000, 1000, 1500, 2000
  sortOrder        Int           @default(0) @map("sort_order")
  isActive         Boolean       @default(true) @map("is_active")
  createdAt        DateTime      @default(now()) @map("created_at")
  progresses       UserMissionProgress[]
  vouchers         MissionVoucher[]

  @@map("weekly_missions")
}

// Per-user, per-week progress on each mission
// One row per (userId, missionId, weekStart).
// weekStart is always the Monday 00:00 UTC of the current week.
model UserMissionProgress {
  id          Int           @id @default(autoincrement())
  userId      Int           @map("user_id")
  missionId   Int           @map("mission_id")
  weekStart   DateTime      @map("week_start")  // Monday 00:00 UTC
  progress    Int           @default(0)          // running count toward target
  completed   Boolean       @default(false)
  completedAt DateTime?     @map("completed_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission     WeeklyMission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId, weekStart])
  @@index([userId, weekStart])
  @@index([missionId])
  @@map("user_mission_progress")
}

// Voucher awarded to a user on mission completion
// Voucher is a generated PromoCode tied to this user only.
model MissionVoucher {
  id          Int           @id @default(autoincrement())
  userId      Int           @map("user_id")
  missionId   Int           @map("mission_id")
  weekStart   DateTime      @map("week_start")
  promoCode   String        @map("promo_code")  // the unique code the user applies at checkout
  amount      Int                               // flat discount in Rs
  minOrder    Int           @map("min_order")   // minimum order to use this voucher
  redeemed    Boolean       @default(false)
  redeemedAt  DateTime?     @map("redeemed_at")
  expiresAt   DateTime      @map("expires_at")  // end of week + 7 days grace
  createdAt   DateTime      @default(now()) @map("created_at")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission     WeeklyMission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId, weekStart])
  @@index([userId])
  @@index([promoCode])
  @@map("mission_vouchers")
}
